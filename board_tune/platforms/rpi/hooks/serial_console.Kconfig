if PLATFORM_RPI && SERIAL_CONSOLE

choice
	prompt "UART"
	depends on BOARD_RPI4
	default RPI4_SERIAL_MINI_UART
	help
	  The Raspberry Pi 4 has a capable PL011 UART and a simpler mini
	  UART whose baud rate follows the VPU clock. Bluetooth uses the
	  PL011 unless it is disabled.

config RPI4_SERIAL_MINI_UART
	bool "Mini UART (GPIO 14/15)"

config RPI4_SERIAL_PL011
	bool "PL011 (GPIO 14/15, Bluetooth off)"
	help
	  Adds dtoverlay=disable-bt and disables the hciuart service.

endchoice

choice
	prompt "UART"
	depends on BOARD_RPI5
	default RPI5_SERIAL_DEBUG

config RPI5_SERIAL_DEBUG
	bool "Debug connector"
	help
	  The 3-pin JST connector between the HDMI ports (ttyAMA10).

config RPI5_SERIAL_GPIO
	bool "GPIO 14/15"
	help
	  Adds dtparam=uart0_console, which moves the serial0 alias and
	  thus the console to UART0 (ttyAMA0).

endchoice

config RPI_SERIAL_FIRMWARE_LOG
	bool "Firmware boot log"
	help
	  Adds uart_2ndstage=1 so the firmware logs to the UART before the
	  kernel starts. Output of the bootloader itself is controlled by
	  BOOT_UART in the EEPROM configuration (rpi-eeprom-config), which
	  is not stored on the boot media.

endif
