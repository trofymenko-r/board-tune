config NETWORK
	bool "Configure Ethernet"
	help
	  Configure a wired Ethernet interface. Settings take effect on
	  the next boot, so a live board never loses its connection
	  halfway through.

if NETWORK

config NETWORK_IFACE
	string "Interface"
	default "eth0"

choice
	prompt "IPv4 mode"
	default NETWORK_DHCP

config NETWORK_DHCP
	bool "DHCP"

config NETWORK_STATIC
	bool "Static address"

endchoice

if NETWORK_STATIC

config NETWORK_ADDRESS
	string "IPv4 address / prefix"
	help
	  For example 192.168.1.50/24.

config NETWORK_GATEWAY
	string "Gateway"
	help
	  Leave empty for a network without a default route.

config NETWORK_DNS
	string "DNS servers"
	help
	  Space-separated list, e.g. "1.1.1.1 8.8.8.8".

endif

menu "Advanced"

choice
	prompt "Energy Efficient Ethernet (EEE)"
	default NETWORK_EEE_KEEP
	help
	  IEEE 802.3az wired Ethernet power saving. Requires ethtool and
	  driver support. A persistent per-interface policy applies on next
	  boot/device attachment and NetworkManager reconnect, never now.
	  Removing the policy returns control to the driver/network manager.
	  On BCM54213PE, running Device Tree restrictions at 100/1000 Mb/s
	  are imported as a disabled boot policy, separately from link state.

config NETWORK_EEE_KEEP
	bool "Keep existing policy"

config NETWORK_EEE_DISABLE
	bool "Disable EEE"

config NETWORK_EEE_ENABLE
	bool "Enable EEE"

config NETWORK_EEE_REMOVE
	bool "Remove board-tune EEE policy"

endchoice

choice
	prompt "Network backend"
	default NETWORK_BACKEND_AUTO

config NETWORK_BACKEND_AUTO
	bool "Automatic"
	help
	  NetworkManager when installed (Raspberry Pi OS Bookworm and
	  later), otherwise systemd-networkd.

config NETWORK_BACKEND_NM
	bool "NetworkManager"

config NETWORK_BACKEND_NETWORKD
	bool "systemd-networkd"

endchoice

endmenu

endif
