config HARDWARE
	bool "Configure hardware interfaces"
	depends on PLATFORM_RPI
	help
	  Configure header I2C, SPI0, GPIO 1-Wire and additional UARTs at boot.
	  Check connected hardware and GPIO assignments before enabling them.

if HARDWARE

choice
	prompt "I2C (GPIO 2/3)"
	default HARDWARE_I2C_KEEP

config HARDWARE_I2C_KEEP
	bool "Keep current"

config HARDWARE_I2C_ENABLE
	bool "Enable"
	help
	  Enable the ARM header I2C bus and load i2c-dev at boot for /dev/i2c-*.

config HARDWARE_I2C_DISABLE
	bool "Disable"
	help
	  Disable the ARM header I2C bus. Other I2C buses and camera interfaces
	  are preserved. The shared i2c-dev module stays available for them.

endchoice

choice
	prompt "SPI0 (GPIO 7-11)"
	default HARDWARE_SPI_KEEP

config HARDWARE_SPI_KEEP
	bool "Keep current"

config HARDWARE_SPI_ENABLE
	bool "Enable"
	help
	  Enable the primary header SPI bus with its default chip selects.
	  Device overlays can replace spidev with their own drivers.

config HARDWARE_SPI_DISABLE
	bool "Disable"
	help
	  Disable the primary SPI bus. Additional SPI buses are preserved.

endchoice

choice
	prompt "1-Wire"
	default HARDWARE_ONEWIRE_KEEP

config HARDWARE_ONEWIRE_KEEP
	bool "Keep current"

config HARDWARE_ONEWIRE_ENABLE
	bool "Enable"
	help
	  Use the standard w1-gpio overlay. Check pin usage and the device's
	  pull-up wiring. No runtime GPIO changes are made.

config HARDWARE_ONEWIRE_DISABLE
	bool "Disable managed overlay"
	help
	  Remove board-tune's 1-Wire overlay. External overlays are preserved;
	  remove their configuration explicitly before disabling here.

endchoice

config HARDWARE_ONEWIRE_GPIO
	int "1-Wire GPIO (BCM)"
	depends on HARDWARE_ONEWIRE_ENABLE
	range 2 27
	default 4
	help
	  Use BCM GPIO numbers, not physical header pin numbers.
	  GPIO 0/1 are reserved for HAT identification and are not offered.

endif
