config SYSTEM
	bool "Configure system settings"
	help
	  Set identity, localisation, time synchronisation and shell conveniences.
	  Empty fields keep the corresponding setting. Locale and keyboard changes take
	  effect for subsequent logins or after a reboot.

if SYSTEM

config SYSTEM_HOSTNAME
	string "Hostname (empty: keep)"

config SYSTEM_TIMEZONE
	string "Time zone (empty: keep)"
	help
	  IANA zone installed on the target, for example Europe/Kyiv.

config SYSTEM_LOCALE
	string "Default language / LANG (empty: keep)"
	help
	  UTF-8 locale, for example uk_UA.UTF-8 or en_US.UTF-8. Other LC_*
	  overrides are preserved. Offline generation runs on next boot.

menu "Keyboard"

config SYSTEM_KEYBOARD_LAYOUT
	string "Layout (empty: keep)"
	help
	  XKB layout or comma-separated layouts, for example us or us,ua.

config SYSTEM_KEYBOARD_VARIANT
	string "Variant"
	depends on SYSTEM_KEYBOARD_LAYOUT != ""

config SYSTEM_KEYBOARD_OPTIONS
	string "Options"
	depends on SYSTEM_KEYBOARD_LAYOUT != ""
	help
	  XKB options, for example grp:alt_shift_toggle.

endmenu

choice
	prompt "Time synchronisation"
	default SYSTEM_NTP_KEEP

config SYSTEM_NTP_KEEP
	bool "Keep current"

config SYSTEM_NTP_ENABLE
	bool "Enable systemd-timesyncd"

config SYSTEM_NTP_DISABLE
	bool "Disable systemd-timesyncd"

endchoice

config SYSTEM_NTP_SERVERS
	string "Custom NTP servers (empty: system defaults)"
	depends on SYSTEM_NTP_ENABLE
	help
	  Space-separated DNS names or IPv4/IPv6 addresses.

menu "Shell and terminal"

comment "Command aliases"

choice
	prompt "ll = ls -la (Bash)"
	default SYSTEM_ALIAS_LL_KEEP
	help
	  System-wide default for new interactive Bash sessions on Debian,
	  Ubuntu and Raspberry Pi OS. Personal shell configuration takes
	  precedence. Existing ll commands, functions and aliases are preserved.

config SYSTEM_ALIAS_LL_KEEP
	bool "Keep current"

config SYSTEM_ALIAS_LL_ENABLE
	bool "Enable default ll alias"

config SYSTEM_ALIAS_LL_REMOVE
	bool "Remove board-tune default ll alias"
	help
	  Remove only the block managed by board-tune. Personal and other
	  administrator-defined aliases are left alone. Existing shells keep
	  their aliases until a new session is opened.

endchoice

endmenu

endif
