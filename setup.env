#!/usr/bin/env bash
# Source this file: . ./setup.env

if [ -z "${BASH_VERSION:-}" ]; then
    printf '%s\n' 'setup.env requires Bash: . ./setup.env' >&2
    # Fall back to exit when executed by another shell instead of sourced.
    # shellcheck disable=SC2317
    return 1 2>/dev/null || exit 1
fi
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    printf '%s\n' 'Source setup.env in your shell: . ./setup.env' >&2
    exit 1
fi

_board_tune_setup() {
    local root venv
    root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" || return 1
    venv="$root/.venv"

    if [[ ! -x "$venv/bin/python" ]]; then
        python3 -m venv "$venv" || {
            printf '%s\n' 'Cannot create .venv; install Python 3 venv support and retry.' >&2
            return 1
        }
    fi
    if [[ ! -x "$venv/bin/board-tune" ]] || ! "$venv/bin/python" -I -c '
from pathlib import Path
import sys
import board_tune
import kconfiglib
assert Path(board_tune.__file__).resolve().parent.parent == Path(sys.argv[1])
' "$root" 2>/dev/null; then
        "$venv/bin/python" -m pip install -e "$root" || return 1
    fi

    # Bootstrap must succeed before changing the caller's active environment.
    # shellcheck disable=SC1091
    . "$venv/bin/activate" || return 1
    case ":${PATH-}:" in
        *":$root/scripts:"*) ;;
        *) export PATH="$root/scripts${PATH:+:$PATH}" ;;
    esac
    hash -r
}

if _board_tune_setup; then
    unset -f _board_tune_setup
else
    unset -f _board_tune_setup
    return 1
fi
